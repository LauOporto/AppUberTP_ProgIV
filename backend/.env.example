# Configuración del Entorno (RT-04, RT-08)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Seguridad y Autenticación JWT (RT-04)
JWT_SECRET=super_secret_jwt_key_min_32_characters_dev_2026
JWT_REFRESH_SECRET=super_refresh_jwt_key_min_32_characters_dev_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Proveedores de Datos (RT-02)
# Proveedor 1: Base de Datos Relacional Principal
DATABASE_URL=file:./dev.db
# Proveedor 2: Proveedor Secundario para Presencia/Realtime
REDIS_URL=redis://localhost:6379

# Límites de Solicitud (Rate Limiting - RT-04)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
