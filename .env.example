# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del proyecto. Lo usan docker compose y el backend.
#   cp .env.example .env
# Los valores de abajo son DE EJEMPLO. Para secretos reales generá valores
# aleatorios, por ejemplo:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# Aplicación
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS, separados por coma. Nunca "*".
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (los usa docker compose para crear la base)
DB_USER=uber_user
DB_PASSWORD=cambiar_esta_password_de_ejemplo
DB_NAME=uber_db
DB_PORT=5432
# URL que usa el backend cuando corre FUERA de Docker (dentro de Docker la arma compose)
DATABASE_URL=postgresql://uber_user:cambiar_esta_password_de_ejemplo@localhost:5432/uber_db

# Redis (presencia, posiciones en vivo, rate limit)
REDIS_URL=redis://localhost:6379

# JWT: mínimo 32 caracteres cada uno y distintos entre sí
JWT_SECRET=ejemplo_access_secret_reemplazar_por_valor_aleatorio_32+
JWT_REFRESH_SECRET=ejemplo_refresh_secret_reemplazar_por_valor_aleatorio_32+
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seguridad y operación
# Factor de costo de bcrypt (declarado en README / ADR-003)
BCRYPT_COST=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Intentos de login/registro/refresh por IP en la ventana
AUTH_RATE_LIMIT_MAX=20
# Opcional: token para leer /metrics desde otra máquina (si no se define, solo desde localhost)
# METRICS_TOKEN=
# Tiempo máximo de apagado ordenado ante SIGTERM
SHUTDOWN_TIMEOUT_MS=10000
